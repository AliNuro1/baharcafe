---
import { site } from "../data/site";
---

<section class="section location" id="contact" aria-labelledby="location-title">
  <div class="container location-grid">
    <div>
      <p class="eyebrow">Find us</p>
      <h2 id="location-title" class="section-title">{site.location.name}</h2>
      <p class="address">
        {site.location.street}<br />
        {site.location.city}
      </p>
      <p class="lede">
        A short walk from everyday Manchester life — look for Bahar Cafe on Claremont Road.
        Exact unit number and postcode will be added here once confirmed.
      </p>
      <p class="placeholder-chip">Address details TBC</p>
      <div class="actions">
        <a class="btn btn-dark" href={site.location.mapsSearchUrl} target="_blank" rel="noreferrer">
          Get Directions
        </a>
        <p class="phone">{site.phone.label}</p>
      </div>
    </div>
    <div class="map" role="img" aria-label="Map placeholder for Bahar Cafe on Claremont Road, Manchester">
      <div class="map-inner">
        <strong>Map placeholder</strong>
        <span>Replace with the Google Maps embed for the confirmed address.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--white);
  }

  .location-grid {
    display: grid;
    gap: 1.4rem;
  }

  .address {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.2;
    margin: 0.85rem 0 0.7rem;
  }

  .actions {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .phone {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .map {
    min-height: 16.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 40%, #cfe7f5 0 18%, transparent 19%),
      radial-gradient(circle at 70% 60%, #d7ead6 0 12%, transparent 13%),
      linear-gradient(135deg, #e7f4fb, #efe7d8);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .map-inner {
    background: rgba(255, 255, 255, 0.92);
    border-radius: 16px;
    padding: 1rem 1.1rem;
    max-width: 18rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .map-inner span {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (min-width: 768px) {
    .location-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 2.5rem;
    }

    .map {
      min-height: 24rem;
    }
  }
</style>
