---
import { site } from "../data/site";
---

<section class="section location" id="contact" aria-labelledby="location-title">
  <div class="container location-grid">
    <div>
      <h2 id="location-title" class="section-title">{site.location.name}</h2>
      <p class="address">
        {site.location.street}<br />
        {site.location.neighbourhood}<br />
        {site.location.city}<br />
        {site.location.postcode}
      </p>
      <p class="lede">Look for Bahar Cafe on Claremont Road, in the heart of Moss Side.</p>
      <div class="actions">
        <a class="btn btn-dark" href={site.location.mapsSearchUrl} target="_blank" rel="noreferrer">
          Get Directions
        </a>
        <a class="phone" href={site.phone.href}>{site.phone.label}</a>
      </div>
    </div>
    <div class="map">
      <iframe
        title="Map of Bahar Cafe, 308 Claremont Road, Manchester"
        src={site.location.mapsEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--white);
  }

  .location-grid {
    display: grid;
    gap: 1.4rem;
  }

  .address {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.2;
    margin: 0.85rem 0 0.7rem;
  }

  .actions {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .phone {
    color: var(--muted);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .phone:hover {
    color: var(--sky-ink);
  }

  .map {
    min-height: 16.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 16.5rem;
    border: 0;
  }

  @media (min-width: 768px) {
    .location-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 2.5rem;
    }

    .map,
    .map iframe {
      min-height: 24rem;
      height: 24rem;
    }
  }
</style>
