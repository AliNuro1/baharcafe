---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">Bahar Cafe</p>
      <p>
        {site.location.street}<br />
        {site.location.city}<br />
        {site.location.postcode}
      </p>
    </div>

    <div class="visit">
      <h2>Visit</h2>
      <dl>
        <div>
          <dt>Hours</dt>
          <dd>
            {
              site.hours.lines.map((line) => (
                <p class="hours-line">
                  <span class="hours-time">{line.time}</span>
                  <span class="hours-days">{line.days}</span>
                </p>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>
            <a href={site.phone.href}>{site.phone.label}</a>
          </dd>
        </div>
      </dl>
    </div>

    <div>
      <h2>Order</h2>
      <a href={site.order.deliveroo.href} target="_blank" rel="noreferrer">
        {site.order.deliveroo.label}
      </a>
      <a href={site.order.justEat.href} target="_blank" rel="noreferrer">
        {site.order.justEat.label}
      </a>
    </div>

    <div>
      <h2>Explore</h2>
      <a href="/">Home</a>
      <a href="/#menu">Menu</a>
      <a href="/#contact">Contact</a>
      <a href="/#order">Order Now</a>
      <h2 class="social-heading">Social</h2>
      {
        site.social.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
  <div class="container copyright">
    <p>© {year} Bahar Cafe. Claremont Road, Manchester.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--sky-mist);
    color: var(--ink);
    padding-top: var(--space-9);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-style: italic;
    font-weight: 600;
    color: var(--heading);
    margin-bottom: 0.8rem;
  }

  h2 {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 0.7rem;
    color: var(--heading);
  }

  .social-heading {
    margin-top: 1.1rem;
  }

  p,
  a {
    margin: 0 0 0.35rem;
    color: inherit;
    text-decoration: none;
    display: block;
    font-size: 0.95rem;
  }

  a:hover {
    color: var(--sky-ink);
  }

  .visit dl {
    margin: 0;
    display: grid;
    gap: 0.95rem;
  }

  .visit dt {
    margin: 0 0 0.2rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .visit dd {
    margin: 0;
  }

  .hours-line {
    margin: 0;
  }

  .hours-time,
  .hours-days,
  .visit a {
    display: block;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: normal;
    color: inherit;
  }

  .hours-days {
    margin-top: 0.12rem;
  }

  .copyright {
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>
