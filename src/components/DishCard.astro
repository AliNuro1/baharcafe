---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  name: string;
  description: string;
}

const { image, name, description } = Astro.props;
---

<article class="card">
  <div class="media">
    <Image
      src={image}
      alt={name}
      widths={[360, 540, 800]}
      sizes="(max-width: 767px) 100vw, (max-width: 1439px) 45vw, 340px"
      quality={72}
    />
  </div>
  <div class="body">
    <h3>{name}</h3>
    <p class="desc">{description}</p>
  </div>
</article>

<style>
  .card {
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(255, 255, 255, 0.8);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--sky-mist);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 420ms ease;
  }

  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .body {
    padding: 1rem 1.05rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
